<Window x:Class="Bank.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Bank.UI"
        mc:Ignorable="d"
        Title="Bank Accounts" Height="520" Width="900" MinHeight="480" MinWidth="700">
    <Grid Background="#F4F6F8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#17324D" Padding="28,22">
            <StackPanel>
                <TextBlock Foreground="White" FontSize="28" FontWeight="SemiBold">Bank accounts</TextBlock>
                <TextBlock Margin="0,6,0,0" Foreground="#D8E4EE" FontSize="14">Manage checking and savings accounts</TextBlock>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" Padding="24" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="White" BorderBrush="#D9E1E8" BorderThickness="1" Padding="22">
                    <StackPanel>
                        <TextBlock FontSize="20" FontWeight="SemiBold" Foreground="#17324D">Checking account</TextBlock>
                        <TextBlock Margin="0,4,0,18" Foreground="#5D6B78">Sam - flexible balance</TextBlock>
                        <TextBlock x:Name="CheckingBalanceText" FontSize="26" FontWeight="SemiBold" Foreground="#16745B" />
                        <TextBlock x:Name="CheckingRateText" Margin="0,3,0,20" Foreground="#5D6B78" />
                        <TextBlock FontWeight="SemiBold">Amount</TextBlock>
                        <TextBox x:Name="CheckingAmountTextBox" Margin="0,7,0,14" Padding="8" FontSize="16" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Padding="10" Content="Deposit" Click="CheckingDeposit_Click" />
                            <Button Grid.Column="2" Padding="10" Content="Withdraw" Click="CheckingWithdraw_Click" />
                        </Grid>
                        <Button Margin="0,12,0,0" Padding="10" Content="Add interest" Click="CheckingInterest_Click" />
                        <TextBlock x:Name="CheckingStatusText" Margin="0,16,0,0" TextWrapping="Wrap" Foreground="#B42318" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="White" BorderBrush="#D9E1E8" BorderThickness="1" Padding="22">
                    <StackPanel>
                        <TextBlock FontSize="20" FontWeight="SemiBold" Foreground="#17324D">Savings account</TextBlock>
                        <TextBlock Margin="0,4,0,18" Foreground="#5D6B78">Sam - protected balance</TextBlock>
                        <TextBlock x:Name="SavingsBalanceText" FontSize="26" FontWeight="SemiBold" Foreground="#16745B" />
                        <TextBlock x:Name="SavingsRateText" Margin="0,3,0,20" Foreground="#5D6B78" />
                        <TextBlock FontWeight="SemiBold">Amount</TextBlock>
                        <TextBox x:Name="SavingsAmountTextBox" Margin="0,7,0,14" Padding="8" FontSize="16" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Padding="10" Content="Deposit" Click="SavingsDeposit_Click" />
                            <Button Grid.Column="2" Padding="10" Content="Withdraw" Click="SavingsWithdraw_Click" />
                        </Grid>
                        <Button Margin="0,12,0,0" Padding="10" Content="Add interest" Click="SavingsInterest_Click" />
                        <TextBlock x:Name="SavingsStatusText" Margin="0,16,0,0" TextWrapping="Wrap" Foreground="#B42318" />
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
